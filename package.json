{
  "name": "flux-coding-agent",
  "version": "0.1.0",
  "description": "A Pi-based terminal coding agent.",
  "type": "module",
  "bin": {
    "flux": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test tests/safety/tools.test.ts tests/providers/config.test.ts tests/persistence/session.test.ts",
    "start": "bun run src/cli.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
