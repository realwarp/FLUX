{
  "name": "flux-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "FLUX — terminal-native AI coding agent",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "flux": "./apps/cli/src/entry.ts"
  },
  "scripts": {
    "flux": "bun run apps/cli/src/entry.ts",
    "dev": "bun run apps/cli/src/entry.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "doctor": "bun run apps/cli/src/entry.ts doctor",
    "lint": "tsc --noEmit -p tsconfig.json",
    "format": "bunx prettier --write \"apps/**/*.ts\" \"apps/**/*.tsx\" \"packages/**/*.ts\" \"packages/**/*.tsx\""
  },
  "dependencies": {
    "@opentui/core": "0.8.3",
    "@opentui/react": "0.8.3",
    "react": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
