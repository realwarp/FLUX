{
  "name": "flux-coding-agent",
  "version": "0.1.0",
  "description": "FLUX — Terminal-native AI Coding Agent.",
  "type": "module",
  "bin": {
    "flux": "dist/src/cli.js"
  },
  "files": [
    "dist/src/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test tests/safety/tools.test.ts tests/safety/windows-acl.test.ts tests/providers/config.test.ts tests/persistence/session.test.ts tests/integration/tools.test.ts tests/integration/identity.test.ts tests/integration/tui02.test.ts tests/integration/tui03.test.ts tests/integration/tui04.test.ts",
    "test:live": "bun run tests/live/runtime-context.ts",
    "test:live:switch": "bun run tests/live/model-switch.ts",
    "start": "bun run src/cli.ts",
    "prepare": "bun run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
