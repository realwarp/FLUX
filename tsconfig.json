{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@flux/shared": ["packages/shared/src/index.ts"],
      "@flux/providers": ["packages/providers/src/index.ts"],
      "@flux/permissions": ["packages/permissions/src/index.ts"],
      "@flux/tools": ["packages/tools/src/index.ts"],
      "@flux/repository": ["packages/repository/src/index.ts"],
      "@flux/persistence": ["packages/persistence/src/index.ts"],
      "@flux/agent-runtime": ["packages/agent-runtime/src/index.ts"],
      "@flux/app-core": ["packages/app-core/src/index.ts"],
      "@flux/tui": ["packages/tui/src/index.tsx"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "packages/**/*.tsx", "tests/**/*.ts"]
}
